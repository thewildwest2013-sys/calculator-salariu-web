# Public application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Web SDK (public identifiers; still keep them in environment variables)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Stripe server/client
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Personal products/prices
STRIPE_PRICE_CREDIT_1=
STRIPE_PRICE_CREDIT_5=
STRIPE_PRICE_CREDIT_12=
STRIPE_PRICE_PERSONAL_MONTHLY=
STRIPE_PRICE_PERSONAL_YEARLY=

# Business subscriptions
STRIPE_PRICE_BUSINESS_STARTER_MONTHLY=
STRIPE_PRICE_BUSINESS_STARTER_YEARLY=
STRIPE_PRICE_BUSINESS_GROWTH_MONTHLY=
STRIPE_PRICE_BUSINESS_GROWTH_YEARLY=
STRIPE_PRICE_BUSINESS_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_PLUS_MONTHLY=
STRIPE_PRICE_BUSINESS_PLUS_YEARLY=
STRIPE_PRICE_BUSINESS_ADDON_5=

# AI provider: Cloudflare primary, Groq optional fallback
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
